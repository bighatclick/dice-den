{
  "expo": {
    "name": "Dice Den",
    "slug": "dice-den",
    "scheme": "diceden",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F0E4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dicedengame.app",
      "entitlements": {
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)$(CFBundleIdentifier)"
      }
    },
    "android": {
      "package": "com.dicedengame.app",
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#8A4520",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "./plugins/withShortCxxPath",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F0E4",
          "dark": {
            "backgroundColor": "#16100C"
          }
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8A4520"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Your answer decides whether the ads between games may use your activity in other apps. Dice Den works the same either way."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (pulled in by expo-notifications) creates its Room database by reflection at app start.\n# Without these, the release build crashes on launch.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }"
          }
        }
      ]
    ]
  }
}
