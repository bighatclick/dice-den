# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# test coverage
coverage/

# Native build output of local Expo modules
modules/*/android/build/
sentry.options.json

# Android e2e runner output (scripts/android-e2e.ps1)
reports/

# Local build checkout, C++ build folder and test run output (kept in E:\PP\dice-den, never committed)
/dd/
/c/
/test-artifacts/

# Credentials kept in the project folder; never commit
/key_id.txt
/Issuer_id.txt
/Vercel token.txt
/AuthKey_*.p8
